{
  "name": "twitchdown",
  "version": "1.3.2",
  "description": "Dead simple Markdown parser for react-like libraries",
  "keywords": [
    "react",
    "markdown",
    "highlight",
    "simple"
  ],
  "main": "index.js",
  "scripts": {
    "test": "npm outdated && eslint **/*.js && ava -v",
    "dev:test": "eslint **/*.js && ava -v",
    "lint": "eslint **/*.js",
    "squish": "uglifyjs index.js > index.min.js",
    "readme": "util/mkReadme.js"
  },
  "repository": "https://gitlab.com/bytesnz/twitchdown.git",
  "author": "Jack Farley <or4e3dsw@bytes.nz>",
  "license": "GPL-3.0",
  "runkitExampleFilename": "example.js",
  "devDependencies": {
    "@ava/babel": "^1.0.1",
    "ava": "3.3.0",
    "eslint": "6.8.0",
    "mock-require": "3.0.3",
    "preact": "10.3.2",
    "react": "16.12.0",
    "sinon": "8.1.1",
    "uglify-js": "^3.7.7"
  },
  "ava": {
    "babel": true
  }
}
