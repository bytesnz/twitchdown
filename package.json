{
  "name": "twitchdown",
  "version": "1.7.0",
  "description": "Dead simple Markdown parser for react-like libraries",
  "keywords": [
    "react",
    "markdown",
    "highlight",
    "simple"
  ],
  "main": "index.js",
  "scripts": {
    "test": "npm outdated && eslint **/*.js && node --test tests/*.test.js",
    "dev:test": "eslint **/*.js && node --test tests/*.test.js",
    "lint": "eslint **/*.js",
    "squish": "uglifyjs index.js > index.min.js",
    "readme": "util/mkReadme.js"
  },
  "repository": "https://gitlab.com/bytesnz/twitchdown.git",
  "author": "Jack Farley <or4e3dsw@bytes.nz>",
  "license": "GPL-3.0",
  "runkitExampleFilename": "example.js",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "preact": "^10.25.4",
    "react": "^19.1.1",
    "uglify-js": "^3.19.3"
  }
}
