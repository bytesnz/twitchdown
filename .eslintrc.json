{
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 3
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "no-multi-spaces": 2,
    "no-unused-expressions": 2,
    "no-shadow": 2,
    "no-trailing-spaces": 2
  },
  "overrides": [
    {
      "files": [ "example.js", "util/mkReadme.js" ],
      "parserOptions": {
        "ecmaVersion": 6
      }
    },
    {
      "files": [ "tests/*.test.js" ],
      "parserOptions": {
        "ecmaVersion": 6,
        "sourceType": "module"
      }
    }
  ]
}
